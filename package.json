{
  "name": "devibe",
  "version": "0.1.0",
  "private": true,
  "description": "Monaco Cloud / DeVibe — AI Cloud OS + agent-managed multi-cloud SDK.",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/project-config' --filter './packages/cloud-providers' --filter './packages/iac-templates' --filter './packages/auth' --filter './packages/mcp-builder' --filter './packages/mcp-marketplace' --filter './packages/qr-access' --filter './packages/cli' --filter './packages/mcp-server' run build",
    "build:web": "pnpm --filter @devibe/web build",
    "typecheck": "pnpm -r --filter './packages/project-config' --filter './packages/cloud-providers' --filter './packages/iac-templates' --filter './packages/auth' --filter './packages/mcp-builder' --filter './packages/mcp-marketplace' --filter './packages/qr-access' --filter './packages/cli' --filter './packages/mcp-server' run typecheck",
    "test": "pnpm run build && pnpm -r --filter './packages/project-config' --filter './packages/cloud-providers' --filter './packages/iac-templates' --filter './packages/auth' --filter './packages/mcp-builder' --filter './packages/mcp-marketplace' --filter './packages/qr-access' --filter './packages/cli' --filter './packages/mcp-server' run test && pnpm run test:functions",
    "test:functions": "vitest run --config vitest.functions.config.ts",
    "clean": "pnpm -r --filter './packages/project-config' --filter './packages/cloud-providers' --filter './packages/iac-templates' --filter './packages/auth' --filter './packages/mcp-builder' --filter './packages/mcp-marketplace' --filter './packages/qr-access' --filter './packages/cli' --filter './packages/mcp-server' run clean",
    "monaco": "pnpm --filter @devibe/cli exec node ./dist/bin.js",
    "dev:mcp": "pnpm --filter @devibe/mcp-server dev",
    "demo": "pnpm run build && pnpm --filter @devibe/mcp-server exec tsx src/demo.ts",
    "prd-validate": "pnpm run build && node scripts/validate-prd-tags.js"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.5",
    "@netlify/functions": "^5.1.2",
    "@anthropic-ai/sdk": "^0.78.0",
    "openai": "^6.22.0"
  }
}
