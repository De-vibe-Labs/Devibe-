{
  "name": "@devibe/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Monaco Cloud first-party CLI — command: monaco",
  "type": "module",
  "bin": {
    "monaco": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@devibe/mcp-marketplace": "workspace:*",
    "@devibe/qr-access": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.5"
  }
}
