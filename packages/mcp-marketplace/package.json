{
  "name": "@devibe/mcp-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Monaco Cloud MCP Marketplace + Universal MCP Standard schema.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
