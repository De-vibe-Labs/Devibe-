{
  "name": "@devibe/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DeVibe Vite + React web app (landing, workspace, orchestration, fleet).",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @devibe/project-config --filter @devibe/cloud-providers --filter @devibe/auth --filter @devibe/mcp-builder run build && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "echo 'apps/web: no unit tests yet'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "@devibe/auth": "workspace:*",
    "@devibe/mcp-builder": "workspace:*"
  },
  "devDependencies": {
    "@netlify/vite-plugin": "^2.7.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
