# DeVibe foundation SDK — Phase 1 uses mocked cloud adapters.
# Real credentials are optional and never required for manage_project / sync_from_prd demos.

DEVIBE_MOCK_CLOUD=true
DEVIBE_AUDIT_LOG=true

# Optional: enable real providers later (not used while DEVIBE_MOCK_CLOUD=true)
# CLOUDFLARE_API_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# AZURE_CLIENT_ID=
