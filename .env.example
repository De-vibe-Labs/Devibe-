# DeVibe foundation SDK — Phase 1 uses mocked cloud adapters.
# Real credentials are optional and never required for manage_project / sync_from_prd demos.

DEVIBE_MOCK_CLOUD=true
DEVIBE_AUDIT_LOG=true

# Auth backends (auto): Firebase (if configured) → Netlify Identity → local demo session.
# DEVIBE_AUTH_MODE=local

# Firebase Google Sign-In + email/password (preferred when set).
# Enable Google + Email providers in Firebase Console → Authentication.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_STORAGE_BUCKET=

# Netlify Identity is used when Firebase is unset and Identity is available after deploy.

# Optional: AI providers for local / non-gateway runs.
# On Netlify with AI Features enabled, do NOT set these — the AI Gateway injects them.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional: enable real providers later (not used while DEVIBE_MOCK_CLOUD=true)
# CLOUDFLARE_API_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# AZURE_CLIENT_ID=
